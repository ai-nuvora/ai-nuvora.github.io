/* ==========================================================================
   NUVORA.AI — GLOBAL DESIGN SYSTEM
   ========================================================================== */

:root {
  /* Brand colors — extracted from the Nuvora.ai logo */
  --nv-charcoal: #2B2B2B;
  --nv-charcoal-dark: #1A1A1A;
  --nv-charcoal-darker: #131313;
  --nv-orange: #F5720A;
  --nv-orange-deep: #E85400;
  --nv-orange-light: #FF8A2E;

  --nv-bg: #FFFFFF;
  --nv-bg-tint: #F7F7F5;
  --nv-bg-dark: #131313;

  --nv-text: #1A1A1A;
  --nv-text-muted: #6B6B6B;
  --nv-text-on-dark: #F5F5F3;
  --nv-text-on-dark-muted: #A8A8A6;

  --nv-border: #E7E5E1;
  --nv-border-dark: #2E2E2E;

  --nv-radius-sm: 8px;
  --nv-radius-md: 14px;
  --nv-radius-lg: 22px;

  --nv-shadow-sm: 0 2px 10px rgba(20, 20, 20, 0.06);
  --nv-shadow-md: 0 10px 30px rgba(20, 20, 20, 0.10);
  --nv-shadow-lg: 0 24px 60px rgba(20, 20, 20, 0.16);

  --nv-font-head: 'Space Grotesk', 'Sora', sans-serif;
  --nv-font-body: 'Inter', system-ui, -apple-system, sans-serif;

  --nv-max-width: 1240px;
  --nv-nav-height: 76px;
}

/* ---------- Reset ---------- */
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: var(--nv-font-body);
  color: var(--nv-text);
  background: var(--nv-bg);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
ul { list-style: none; margin: 0; padding: 0; }
h1, h2, h3, h4 {
  font-family: var(--nv-font-head);
  font-weight: 700;
  line-height: 1.15;
  margin: 0 0 0.5em;
  letter-spacing: -0.01em;
}
p { margin: 0 0 1em; }
button { font-family: inherit; cursor: pointer; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

/* ---------- Layout helpers ---------- */
.container {
  max-width: var(--nv-max-width);
  margin: 0 auto;
  padding: 0 24px;
}
.section { padding: 88px 0; }
.section-tight { padding: 56px 0; }
.section-head {
  max-width: 640px;
  margin: 0 0 40px;
}
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--nv-orange);
  margin-bottom: 12px;
}
.eyebrow::before {
  content: "";
  width: 18px; height: 2px;
  background: var(--nv-orange);
  display: inline-block;
}
.section-head h2 { font-size: clamp(28px, 4vw, 38px); }
.section-head p { color: var(--nv-text-muted); font-size: 17px; }
.section-foot { margin-top: 32px; text-align: center; }

.visually-hidden {
  position: absolute; width: 1px; height: 1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap;
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 26px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 15px;
  border: 1px solid transparent;
  transition: transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.25s, background 0.25s, color .25s;
  will-change: transform;
}
.btn:active { transform: translateY(1px) scale(0.98); }
.btn-primary {
  background: var(--nv-orange);
  color: #fff;
  box-shadow: 0 8px 20px rgba(245, 114, 10, 0.35);
}
.btn-primary:hover { background: var(--nv-orange-deep); transform: translateY(-2px); box-shadow: 0 14px 28px rgba(245,114,10,0.4); }
.btn-outline {
  background: transparent;
  color: var(--nv-text-on-dark);
  border-color: rgba(245,245,243,0.35);
}
.btn-outline:hover { border-color: #fff; transform: translateY(-2px); }
.btn-dark {
  background: var(--nv-charcoal);
  color: #fff;
}
.btn-dark:hover { background: var(--nv-charcoal-dark); transform: translateY(-2px); }
.btn-ghost {
  color: var(--nv-charcoal);
  border-color: var(--nv-border);
  background: #fff;
}
.btn-ghost:hover { border-color: var(--nv-orange); color: var(--nv-orange); }

/* ---------- Header / nav ---------- */
.site-header {
  position: sticky; top: 0; z-index: 100;
  height: var(--nv-nav-height);
  display: flex; align-items: center;
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(14px) saturate(160%);
  -webkit-backdrop-filter: blur(14px) saturate(160%);
  border-bottom: 1px solid var(--nv-border);
  transition: box-shadow .3s ease;
}
.site-header.is-scrolled { box-shadow: var(--nv-shadow-sm); }
.nav-inner {
  width: 100%;
  display: flex; align-items: center; justify-content: space-between;
}
.brand { display: flex; align-items: center; gap: 10px; font-family: var(--nv-font-head); }
.brand img { height: 30px; width: auto; }
.brand-word { font-size: 20px; font-weight: 700; color: var(--nv-charcoal); }
.brand-word .ai { color: var(--nv-orange); }

.nav-links { display: flex; align-items: center; gap: 34px; }
.nav-links a {
  font-size: 15px; font-weight: 600; color: var(--nv-text);
  position: relative; padding: 6px 0;
}
.nav-links a::after {
  content: ""; position: absolute; left: 0; right: 100%; bottom: 0;
  height: 2px; background: var(--nv-orange);
  transition: right .25s ease;
}
.nav-links a:hover::after, .nav-links a.is-active::after { right: 0; }
.nav-links a.is-active { color: var(--nv-orange); }

.nav-cta { display: flex; align-items: center; gap: 14px; }
.nav-toggle {
  display: none; background: none; border: none; padding: 6px;
}
.nav-toggle span {
  display: block; width: 22px; height: 2px; margin: 5px 0;
  background: var(--nv-charcoal); transition: all .25s ease;
}

@media (max-width: 860px) {
  .nav-links {
    position: fixed; top: var(--nv-nav-height); left: 0; right: 0;
    background: #fff; flex-direction: column; align-items: flex-start;
    padding: 22px 24px; gap: 18px; border-bottom: 1px solid var(--nv-border);
    transform: translateY(-8px); opacity: 0; pointer-events: none;
    transition: all .25s ease;
  }
  .nav-links.is-open { transform: translateY(0); opacity: 1; pointer-events: auto; }
  .nav-toggle { display: block; }
}

/* ---------- Hero (shared shell; each page sets its own canvas + copy) ---------- */
.hero {
  position: relative;
  background: var(--nv-charcoal-darker);
  color: var(--nv-text-on-dark);
  overflow: hidden;
  isolation: isolate;
}
.hero-canvas {
  position: absolute; inset: 0;
  z-index: 1;
}
.hero-canvas canvas { display: block; width: 100%; height: 100%; }
.hero-fallback {
  position: absolute; inset: 0; z-index: 0;
  background:
    radial-gradient(46% 60% at 80% 25%, rgba(245,114,10,0.30), transparent 70%),
    repeating-linear-gradient(0deg, rgba(245,114,10,0.06) 0px, rgba(245,114,10,0.06) 1px, transparent 1px, transparent 48px),
    repeating-linear-gradient(90deg, rgba(245,114,10,0.06) 0px, rgba(245,114,10,0.06) 1px, transparent 1px, transparent 48px),
    linear-gradient(180deg, #161616, #0d0d0d 60%, #131313);
  background-size: auto, 48px 48px, 48px 48px, auto;
}
.hero-inner {
  position: relative; z-index: 2;
  padding: 150px 0 120px;
}
.hero.hero-compact .hero-inner { padding: 120px 0 90px; }
.hero-content { max-width: 620px; }
.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 700; letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--nv-orange-light);
  margin-bottom: 18px;
}
.hero h1 {
  font-size: clamp(36px, 5.4vw, 62px);
  color: #fff;
  margin-bottom: 20px;
}
.hero h1 .accent { color: var(--nv-orange); }
.hero p {
  font-size: 18px;
  color: var(--nv-text-on-dark-muted);
  max-width: 520px;
  margin-bottom: 34px;
}
.hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
.hero-gradient-edge {
  position: absolute; left: 0; right: 0; bottom: -1px; height: 120px; z-index: 1;
  background: linear-gradient(to bottom, transparent, var(--nv-bg));
  pointer-events: none;
}

/* ---------- Reveal-on-scroll (Tier 2 3D) ---------- */
.reveal {
  opacity: 0;
  transform: translate3d(0, 34px, -40px) rotateX(6deg);
  transform-origin: bottom center;
  transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1);
  will-change: transform, opacity;
}
.reveal.is-visible {
  opacity: 1;
  transform: translate3d(0,0,0) rotateX(0);
}
.reveal-stagger.is-visible { transition-delay: var(--stagger, 0ms); }

/* ---------- Cards ---------- */
.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 26px;
}
@media (max-width: 980px) { .card-grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 640px) { .card-grid { grid-template-columns: 1fr; } }

.article-card {
  background: #fff;
  border: 1px solid var(--nv-border);
  border-radius: var(--nv-radius-md);
  overflow: hidden;
  display: flex; flex-direction: column;
  perspective: 900px;
  transition: box-shadow .35s ease, border-color .35s ease;
}
.article-card:hover { box-shadow: var(--nv-shadow-lg); border-color: transparent; }
.article-card-tilt {
  transition: transform .25s cubic-bezier(.2,.7,.2,1);
  transform-style: preserve-3d;
  display: flex; flex-direction: column; flex: 1;
}
.article-card-media {
  aspect-ratio: 16/10;
  background: linear-gradient(135deg, var(--nv-charcoal), #3a3a3a);
  position: relative; overflow: hidden;
}
.article-card-media img { width: 100%; height: 100%; object-fit: cover; }
.article-card-cat {
  position: absolute; top: 14px; left: 14px;
  background: rgba(255,255,255,0.92);
  color: var(--nv-charcoal);
  font-size: 12px; font-weight: 700; letter-spacing: .03em;
  text-transform: uppercase;
  padding: 6px 12px; border-radius: 999px;
}
.article-card-cat.tech { color: var(--nv-orange-deep); }
.article-card-body { padding: 22px; flex: 1; display: flex; flex-direction: column; }
.article-card-body h3 { font-size: 19px; margin-bottom: 10px; }
.article-card-body p { color: var(--nv-text-muted); font-size: 14.5px; flex: 1; }
.article-card-meta {
  display: flex; align-items: center; gap: 10px;
  font-size: 12.5px; color: var(--nv-text-muted); margin-top: 16px;
}
.article-card-meta span::after { content: "•"; margin-left: 10px; }
.article-card-meta span:last-child::after { content: ""; }
.article-card-link {
  margin-top: 16px; font-weight: 700; color: var(--nv-orange);
  font-size: 14px; display: inline-flex; align-items: center; gap: 6px;
}
.article-card-link svg { transition: transform .25s ease; }
.article-card:hover .article-card-link svg { transform: translateX(4px); }

/* ---------- Topic pills ---------- */
.pill-cloud { display: flex; flex-wrap: wrap; gap: 12px; }
.pill {
  padding: 10px 18px;
  border-radius: 999px;
  background: var(--nv-bg-tint);
  border: 1px solid var(--nv-border);
  font-size: 14px; font-weight: 600;
  animation: float 6s ease-in-out infinite;
}
.pill:nth-child(2n) { animation-delay: -1.5s; }
.pill:nth-child(3n) { animation-delay: -3s; }
.pill:hover { border-color: var(--nv-orange); color: var(--nv-orange); background: #fff; }
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

/* ---------- Icon feature grid ---------- */
.feature-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 22px; }
@media (max-width: 980px) { .feature-grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 560px) { .feature-grid { grid-template-columns: 1fr; } }
.feature-card {
  padding: 26px; border-radius: var(--nv-radius-md);
  border: 1px solid var(--nv-border);
  background: #fff;
}
.feature-icon {
  width: 46px; height: 46px; border-radius: 12px;
  background: linear-gradient(135deg, var(--nv-orange), var(--nv-orange-deep));
  display: flex; align-items: center; justify-content: center;
  color: #fff; margin-bottom: 16px;
}
.feature-card h3 { font-size: 17px; margin-bottom: 8px; }
.feature-card p { font-size: 14px; color: var(--nv-text-muted); margin: 0; }

/* ---------- CTA band ---------- */
.cta-band {
  position: relative;
  background: var(--nv-charcoal-darker);
  color: #fff;
  border-radius: var(--nv-radius-lg);
  padding: 64px 48px;
  overflow: hidden;
  text-align: center;
}
.cta-band::before {
  content: ""; position: absolute; inset: -40%;
  background: radial-gradient(closest-side, rgba(245,114,10,0.35), transparent 70%);
  animation: drift 12s ease-in-out infinite;
}
@keyframes drift {
  0%,100% { transform: translate(-10%, -10%) scale(1); }
  50% { transform: translate(10%, 10%) scale(1.15); }
}
.cta-band-inner { position: relative; z-index: 1; }
.cta-band h2 { font-size: clamp(26px,4vw,36px); margin-bottom: 12px; }
.cta-band p { color: var(--nv-text-on-dark-muted); margin-bottom: 30px; }
.cta-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

/* ---------- Footer ---------- */
.site-footer {
  background: var(--nv-charcoal-darker);
  color: var(--nv-text-on-dark-muted);
  padding: 64px 0 32px;
}
.footer-grid {
  display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px;
  padding-bottom: 40px; border-bottom: 1px solid var(--nv-border-dark);
}
@media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
.footer-brand img { height: 30px; margin-bottom: 14px; }
.footer-brand p { font-size: 14px; max-width: 280px; }
.footer-col h4 {
  color: #fff; font-size: 13px; letter-spacing: .06em; text-transform: uppercase;
  margin-bottom: 16px;
}
.footer-col a, .footer-col span { display: block; font-size: 14.5px; margin-bottom: 10px; }
.footer-col a:hover { color: var(--nv-orange-light); }
.footer-bottom {
  display: flex; justify-content: space-between; align-items: center;
  padding-top: 24px; font-size: 13px; flex-wrap: wrap; gap: 12px;
}

/* ---------- Page header (non-hero pages: legal etc.) ---------- */
.page-header {
  padding: 150px 0 60px;
  background: var(--nv-bg-tint);
  border-bottom: 1px solid var(--nv-border);
}
.page-header h1 { font-size: clamp(30px,4vw,44px); }
.page-header p { color: var(--nv-text-muted); max-width: 640px; }
.breadcrumbs { font-size: 13px; color: var(--nv-text-muted); margin-bottom: 18px; }
.breadcrumbs a:hover { color: var(--nv-orange); }

/* ---------- Prose (legal + article body) ---------- */
.prose { max-width: 760px; }
.prose h2 { font-size: 24px; margin-top: 2em; }
.prose h3 { font-size: 19px; margin-top: 1.6em; }
.prose p, .prose li { color: #333; font-size: 16px; }
.prose ul, .prose ol { padding-left: 22px; margin-bottom: 1em; }
.prose li { margin-bottom: 8px; }
.prose a { color: var(--nv-orange); text-decoration: underline; text-underline-offset: 2px; }

/* ---------- Filter bar (blog) ---------- */
.filter-bar {
  display: flex; align-items: center; justify-content: space-between;
  gap: 20px; flex-wrap: wrap; margin-bottom: 36px;
}
.filter-tabs { display: flex; gap: 10px; }
.filter-tab {
  padding: 9px 18px; border-radius: 999px; font-size: 14px; font-weight: 700;
  border: 1px solid var(--nv-border); background: #fff; color: var(--nv-text-muted);
  transition: all .2s ease;
}
.filter-tab.is-active, .filter-tab:hover { border-color: var(--nv-orange); color: var(--nv-orange); }
.search-box {
  display: flex; align-items: center; gap: 8px;
  border: 1px solid var(--nv-border); border-radius: 999px;
  padding: 9px 16px; min-width: 240px;
}
.search-box input {
  border: none; outline: none; font-size: 14px; width: 100%; background: transparent;
}

/* ---------- Contact page ---------- */
.contact-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
@media (max-width: 860px) { .contact-wrap { grid-template-columns: 1fr; } }
.contact-orbs { position: relative; min-height: 260px; }
.orb {
  position: absolute; border-radius: 50%; filter: blur(2px);
  animation: orbit 10s ease-in-out infinite;
}
.orb-1 { width: 160px; height:160px; background: radial-gradient(circle at 30% 30%, var(--nv-orange-light), var(--nv-orange-deep)); top: 0; left: 10%; opacity:.85; }
.orb-2 { width: 100px; height:100px; background: radial-gradient(circle at 30% 30%, #4a4a4a, var(--nv-charcoal-dark)); bottom: 0; right: 10%; animation-delay: -3s; }
@keyframes orbit {
  0%,100% { transform: translate(0,0); }
  50% { transform: translate(20px,-24px); }
}
.contact-method { display:flex; gap:14px; align-items:flex-start; padding: 18px 0; border-bottom: 1px solid var(--nv-border); }
.contact-method .ic {
  width:42px;height:42px;border-radius:10px;background:var(--nv-bg-tint);
  display:flex;align-items:center;justify-content:center;color:var(--nv-orange);flex-shrink:0;
}
.contact-method h4 { margin:0 0 4px; font-size:15px; }
.contact-method p { margin:0; font-size:14px; color: var(--nv-text-muted); }
.contact-method a { font-weight:600; color: var(--nv-text); }
.contact-method a:hover { color: var(--nv-orange); }

.form-field { margin-bottom: 20px; }
.form-field label {
  display:block; font-size: 13px; font-weight: 700; margin-bottom: 8px;
  text-transform: uppercase; letter-spacing: .04em; color: var(--nv-text-muted);
}
.form-field input, .form-field textarea {
  width: 100%; padding: 14px 16px; border-radius: var(--nv-radius-sm);
  border: 1px solid var(--nv-border); font-family: inherit; font-size: 15px;
  transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  background: #fff;
}
.form-field textarea { min-height: 130px; resize: vertical; }
.form-field input:focus, .form-field textarea:focus {
  outline: none; border-color: var(--nv-orange);
  box-shadow: 0 0 0 4px rgba(245,114,10,0.14);
  transform: translateZ(6px);
}

/* ---------- About timeline ---------- */
.timeline { max-width: 720px; }
.timeline-item {
  padding: 28px 0 28px 30px; border-left: 2px solid var(--nv-border); position: relative;
}
.timeline-item::before {
  content:""; position:absolute; left:-7px; top:32px; width:12px;height:12px;border-radius:50%;
  background: var(--nv-orange); box-shadow: 0 0 0 4px rgba(245,114,10,0.16);
}
.timeline-item h3 { font-size: 18px; margin-bottom: 6px; }
.timeline-item p { color: var(--nv-text-muted); margin: 0; font-size: 15px; }

/* ---------- Utility ---------- */
.text-center { text-align: center; }
.mt-0 { margin-top: 0; }
